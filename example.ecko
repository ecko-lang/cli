# cli demo. Normally you'd pass os.args(); a fixed argv keeps output deterministic.
import "./main.ecko"
cli = main

spec = {
    name: "greet",
    about: "print a friendly greeting",
    options: [
        { name: "loud", short: "l", flag: true, help: "shout it" },
        { name: "count", short: "n", default: 1, help: "repeat N times" },
    ],
    args: [{ name: "name", required: true, help: "who to greet" }],
}

r = cli.parse(spec, ["--loud", "-n", "2", "Ada"])
if r.help { print(cli.help(spec)) } else {
    greeting = if r.options.loud { "HELLO, {r.args.name}!" } else { "Hello, {r.args.name}." }
    mut i = 0
    while i < r.options.count {
        print(greeting)
        i = i + 1
    }
}
print("")
print(cli.help(spec))
